pipeline {
    agent any
    
    tools {
        // If you have Python installed via Jenkins tools
        python 'Python3'
    }
    
    environment {
        // Set any environment variables if needed
        PYTHONPATH = "${WORKSPACE}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                // Checkout code from GitHub
                git branch: 'main', 
                    credentialsId: 'github-creds', // You'll need to set this up in Jenkins
                    url: 'https://github.com/AmareUshule/alx-backend-python.git'
                
                // Navigate to messaging_app directory
                dir('messaging_app') {
                    sh 'pwd'
                    sh 'ls -la'
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir('messaging_app') {
                    // Install Python dependencies
                    sh 'pip install -r requirements.txt || pip install pytest pytest-cov || true'
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir('messaging_app') {
                    // Run pytest with coverage
                    sh 'python -m pytest tests/ -v --junitxml=test-results.xml --cov=. --cov-report=xml:coverage.xml'
                }
            }
            post {
                always {
                    // Archive test results
                    junit 'messaging_app/test-results.xml'
                    
                    // Archive coverage report if exists
                    script {
                        if (fileExists('messaging_app/coverage.xml')) {
                            publishCoverage adapters: [coberturaAdapter('messaging_app/coverage.xml')]
                        }
                    }
                }
            }
        }
        
        stage('Generate Report') {
            steps {
                dir('messaging_app') {
                    // Generate any additional reports if needed
                    sh 'echo "Test execution completed at $(date)" > test_report.txt'
                }
            }
            post {
                always {
                    // Archive artifacts
                    archiveArtifacts artifacts: 'messaging_app/test_report.txt', fingerprint: true
                    
                    // Clean workspace (optional)
                    cleanWs()
                }
            }
        }
    }
    
    post {
        always {
            // Send notifications or perform cleanup
            echo 'Pipeline completed'
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
