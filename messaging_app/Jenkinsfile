pipeline {
    agent any
    
    environment {
        DOCKER_USER = credentials('dockerhub-username')
        DOCKER_PASS = credentials('dockerhub-password')
        IMAGE_NAME = 'your-dockerhub-username/messaging-app'
    }
    
    stages {
        stage('Git Checkout') {
            steps {
                git credentialsId: 'github-credentials', 
                    url: 'https://github.com/your-username/alx-backend-python.git',
                    branch: 'main'
            }
        }
        
        stage('Install & Test') {
            steps {
                dir('messaging_app') {
                    sh 'pip install -r requirements.txt'
                    sh 'python -m pytest tests/ --junitxml=results.xml'
                }
            }
            post {
                always {
                    junit 'messaging_app/results.xml'
                }
            }
        }
        
        stage('Build Image') {
            steps {
                dir('messaging_app') {
                    sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
                    sh 'docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest'
                }
            }
        }
        
        stage('Push Image') {
            steps {
                sh '''
                    echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin
                    docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                    docker push ${IMAGE_NAME}:latest
                    docker logout
                '''
            }
        }
    }
    
    post {
        success {
            echo 'Docker image built and pushed successfully!'
        }
    }
}
