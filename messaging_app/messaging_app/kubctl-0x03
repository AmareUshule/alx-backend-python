#!/bin/bash

# kubctl-0x03 - Rolling Update Script
# Simple script to perform rolling updates

echo "=== Rolling Update Script ==="
echo "Updating Django app from v1.0 to v2.0"
echo ""

# Configuration
DEPLOYMENT="django-messaging-deployment"
SERVICE="django-messaging-service"
TEST_URL="http://localhost:8000"

# Function to check if command exists
check_command() {
    if ! command -v $1 &> /dev/null; then
        echo "Error: $1 is not installed"
        exit 1
    fi
}

# Check required commands
check_command kubectl
check_command curl

# Step 1: Show current state
echo "1. Current deployment status:"
kubectl get deployments
echo ""

echo "Current pods:"
kubectl get pods -l app=django-messaging
echo ""

echo "Current image version:"
kubectl get deployment $DEPLOYMENT -o jsonpath='{.spec.template.spec.containers[0].image}'
echo ""
echo ""

# Step 2: Start continuous curl test in background
echo "2. Starting continuous requests to test for downtime..."
echo "   (Press Ctrl+C to stop the test when update is complete)"
echo ""

# Function to make requests
make_request() {
    while true; do
        # Get current time
        timestamp=$(date '+%Y-%m-%d %H:%M:%S')
        
        # Make request and check response
        if curl -s -f --max-time 5 $TEST_URL/health/ > /dev/null; then
            echo "[$timestamp] ✓ Request successful"
        else
            echo "[$timestamp] ✗ Request failed - Possible downtime!"
        fi
        
        # Wait 1 second between requests
        sleep 1
    done
}

# Run continuous test in background
make_request &
TEST_PID=$!

# Wait a moment for test to start
sleep 3

# Step 3: Apply the updated deployment
echo ""
echo "3. Applying rolling update to version 2.0..."
echo "   Updating image to: your-dockerhub-username/django-messaging-app:2.0"
kubectl apply -f blue_deployment.yaml
echo ""

# Step 4: Monitor the rollout
echo "4. Monitoring rollout status..."
echo "   (This will wait until the update is complete)"
echo ""

kubectl rollout status deployment/$DEPLOYMENT --timeout=300s

if [ $? -eq 0 ]; then
    echo ""
    echo "✓ Rolling update completed successfully!"
else
    echo ""
    echo "✗ Rolling update failed or timed out"
    # Stop the test
    kill $TEST_PID 2>/dev/null
    exit 1
fi

# Step 5: Stop the continuous test
echo ""
echo "5. Stopping continuous test..."
kill $TEST_PID 2>/dev/null
echo ""

# Step 6: Verify the update
echo "6. Verifying the update is complete:"
echo ""

echo "Updated pods:"
kubectl get pods -l app=django-messaging
echo ""

echo "Updated image version:"
kubectl get deployment $DEPLOYMENT -o jsonpath='{.spec.template.spec.containers[0].image}'
echo ""

echo "Rollout history:"
kubectl rollout history deployment/$DEPLOYMENT
echo ""

# Step 7: Final test
echo "7. Final test - making 5 requests to confirm app is working:"
for i in {1..5}; do
    if curl -s $TEST_URL/health/ | grep -q "healthy\|OK"; then
        echo "   Request $i: ✓ Success"
    else
        echo "   Request $i: ✗ Failed"
    fi
    sleep 1
done

echo ""
echo "=== Rolling Update Complete ==="
echo "✓ Application updated to version 2.0"
echo "✓ No downtime detected"
echo "✓ All pods running with new image"
