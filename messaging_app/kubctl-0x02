#!/bin/bash

# kubctl-0x02 - Blue-Green Deployment Script
# Simple script for zero-downtime deployments

echo "=========================================="
echo "Blue-Green Deployment Script"
echo "=========================================="

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
BLUE_DEPLOYMENT="django-messaging-blue"
GREEN_DEPLOYMENT="django-messaging-green"
MAIN_SERVICE="django-messaging-service"
NAMESPACE="default"

# Function to print colored messages
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to wait for deployment to be ready
wait_for_deployment() {
    local deployment=$1
    local max_attempts=30
    local attempt=1
    
    print_info "Waiting for $deployment to be ready..."
    
    while [[ $attempt -le $max_attempts ]]; do
        if kubectl get deployment $deployment -n $NAMESPACE -o jsonpath='{.status.readyReplicas}' | grep -q '2'; then
            print_success "$deployment is ready with 2 replicas"
            return 0
        fi
        
        print_info "Attempt $attempt/$max_attempts: Checking $deployment..."
        sleep 5
        ((attempt++))
    done
    
    print_error "Timeout waiting for $deployment to be ready"
    return 1
}

# Function to check deployment logs
check_logs() {
    local deployment=$1
    local pod_count=$(kubectl get pods -n $NAMESPACE -l app=django-messaging,version=$deployment -o name | wc -l)
    
    print_info "Checking logs for $deployment deployment ($pod_count pods)..."
    
    # Get all pods for the deployment
    local pods=$(kubectl get pods -n $NAMESPACE -l app=django-messaging,version=$deployment -o name)
    
    for pod in $pods; do
        print_info "Logs for $pod:"
        echo "----------------------------------------"
        kubectl logs $pod -n $NAMESPACE --tail=10
        echo "----------------------------------------"
        
        # Check for common errors
        if kubectl logs $pod -n $NAMESPACE | grep -i "error\|exception\|failed"; then
            print_warning "Found errors in $pod logs"
        else
            print_success "No errors found in $pod logs"
        fi
    done
}

# Function to switch traffic
switch_traffic() {
    local target_version=$1
    
    print_info "Switching traffic to $target_version version..."
    
    # Update the main service selector
    kubectl patch service $MAIN_SERVICE -n $NAMESPACE -p "{\"spec\":{\"selector\":{\"version\":\"$target_version\"}}}"
    
    if [ $? -eq 0 ]; then
        print_success "Traffic switched to $target_version"
        
        # Verify the switch
        print_info "Verifying service selector..."
        kubectl get service $MAIN_SERVICE -n $NAMESPACE -o jsonpath='{.spec.selector.version}'
        echo ""
    else
        print_error "Failed to switch traffic"
        return 1
    fi
}

# Main deployment flow
main() {
    echo ""
    print_info "Step 1: Deploying Blue version (current stable)..."
    kubectl apply -f blue_deployment.yaml
    
    if wait_for_deployment "blue"; then
        print_success "Blue deployment successful"
        check_logs "blue"
    else
        print_error "Blue deployment failed"
        exit 1
    fi
    
    echo ""
    print_info "Step 2: Deploying Green version (new version)..."
    kubectl apply -f green_deployment.yaml
    
    if wait_for_deployment "green"; then
        print_success "Green deployment successful"
        check_logs "green"
    else
        print_error "Green deployment failed"
        exit 1
    fi
    
    echo ""
    print_info "Step 3: Applying main service configuration..."
    kubectl apply -f kubeservice.yaml
    
    echo ""
    print_info "Current state:"
    echo "----------------------------------------"
    kubectl get deployments -n $NAMESPACE -l app=django-messaging
    echo ""
    kubectl get pods -n $NAMESPACE -l app=django-messaging
    echo ""
    kubectl get services -n $NAMESPACE -l app=django-messaging
    
    echo ""
    print_info "Step 4: Testing Green version before switch..."
    print_info "You can manually test the green version before switching traffic:"
    echo "kubectl port-forward service/django-messaging-green-service 8080:8000"
    echo "Then visit: http://localhost:8080"
    echo ""
    read -p "Press Enter to continue with traffic switch, or Ctrl+C to abort..."
    
    echo ""
    print_info "Step 5: Switching traffic from Blue to Green..."
    switch_traffic "green"
    
    echo ""
    print_info "Step 6: Final verification..."
    print_info "Current traffic is now routed to: $(kubectl get service $MAIN_SERVICE -n $NAMESPACE -o jsonpath='{.spec.selector.version}')"
    
    echo ""
    print_success "=========================================="
    print_success "Blue-Green deployment completed!"
    print_success "Traffic is now flowing to Green version"
    print_success "=========================================="
    
    # Optional: Scale down blue after verification
    echo ""
    read -p "Do you want to scale down Blue deployment? (y/n): " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        print_info "Scaling down Blue deployment..."
        kubectl scale deployment $BLUE_DEPLOYMENT --replicas=0 -n $NAMESPACE
        print_success "Blue deployment scaled down"
    fi
}

# Handle command line arguments
case "$1" in
    deploy-green)
        print_info "Deploying Green version only..."
        kubectl apply -f green_deployment.yaml
        wait_for_deployment "green"
        check_logs "green"
        ;;
    switch-to-green)
        switch_traffic "green"
        ;;
    switch-to-blue)
        switch_traffic "blue"
        ;;
    rollback)
        print_info "Rolling back to Blue version..."
        switch_traffic "blue"
        kubectl scale deployment $GREEN_DEPLOYMENT --replicas=0 -n $NAMESPACE
        ;;
    status)
        echo "Current deployments:"
        kubectl get deployments -n $NAMESPACE -l app=django-messaging
        echo ""
        echo "Current pods:"
        kubectl get pods -n $NAMESPACE -l app=django-messaging
        echo ""
        echo "Service routing:"
        kubectl get service $MAIN_SERVICE -n $NAMESPACE -o jsonpath='{.spec.selector.version}'
        echo ""
        ;;
    help|--help|-h)
        echo "Usage: $0 [command]"
        echo ""
        echo "Commands:"
        echo "  deploy-green     - Deploy only the green version"
        echo "  switch-to-green  - Switch traffic to green version"
        echo "  switch-to-blue   - Switch traffic to blue version"
        echo "  rollback         - Rollback to blue version"
        echo "  status           - Show current deployment status"
        echo "  help             - Show this help message"
        echo ""
        echo "Without arguments, runs full blue-green deployment"
        ;;
    *)
        # Run main function if no arguments
        main
        ;;
esac
